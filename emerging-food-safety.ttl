@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix efs: <https://fredbrug.github.io/skohub-pages/emerging-food-safety/> .

# Emerging Food Safety vocabulary
# Converted from the uploaded OWL class hierarchy to SKOS for SkoHub publication.

efs:scheme a skos:ConceptScheme ;
    skos:prefLabel "Emerging Food Safety"@en ;
    dct:title "Emerging Food Safety"@en ;
    dct:description "Controlled vocabulary for emerging food safety concepts."@en ;
    skos:hasTopConcept efs:Geography, efs:Novelty, efs:Food, efs:Substance, efs:SupportiveClasses, efs:Effect .

efs:AdverseEffects a skos:Concept ;
    skos:prefLabel "Adverse Effects"@en ;
    skos:inScheme efs:scheme ;
    skos:broader efs:ToxicEffects ;
    skos:broaderTransitive efs:ToxicEffects .

