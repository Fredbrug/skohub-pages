{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/scheme","type":"ConceptScheme","title":{"en":"Early Signals for Emerging Food Safety Risks"},"description":{"en":"A SKOS vocabulary for food safety concepts, early-signal identification, historical analysis, and historical food safety cases."},"hasTopConcept":[{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/food-safety","prefLabel":{"en":"Food safety"},"definition":{"en":"The protection of human or animal health against biological, chemical or physical agents in food that can cause adverse health effects."},"narrower":[{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/food-safety-hazard","prefLabel":{"en":"Food safety hazard"},"altLabel":{"en":["Food hazard"]},"definition":{"en":"A biological, chemical or physical agent in food, or a condition of food, with the potential to cause an adverse health effect."},"narrower":[{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/emerging-food-safety-hazard","prefLabel":{"en":"Emerging food safety hazard"},"altLabel":{"en":["Emerging hazard"]},"definition":{"en":"A newly identified or changing hazard for which developing information may indicate a future food safety risk."}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/known-hazard","prefLabel":{"en":"Known food safety hazard"},"altLabel":{"en":["Established hazard"]},"definition":{"en":"A hazard already recognized in existing food safety knowledge or risk analysis."},"narrower":[{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/recurring-hazard","prefLabel":{"en":"Recurring food safety hazard"},"altLabel":{"en":["Re-emerging hazard"]},"definition":{"en":"A known hazard that reappears over time, possibly through a new source, process or exposure route."}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/forgotten-hazard","prefLabel":{"en":"Forgotten hazard"},"definition":{"en":"A previously documented hazard that is no longer actively recognized and may appear new when it re-emerges."}}]},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/unknown-hazard","prefLabel":{"en":"Previously unknown hazard"},"altLabel":{"en":["New hazard","Unexpected hazard"]},"definition":{"en":"A hazardous substance, organism or condition not previously recognized as a food safety hazard."}}]},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/food-safety-risk","prefLabel":{"en":"Food safety risk"},"definition":{"en":"A function of the probability and severity of an adverse health effect resulting from a hazard in food."},"narrower":[{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/emerging-food-safety-risk","prefLabel":{"en":"Emerging food safety risk"},"altLabel":{"en":["Emerging risk"]},"definition":{"en":"A risk resulting from a newly identified hazard involving potentially significant exposure, or from a known hazard involving an unexpected new or increased exposure."}}]},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/food-safety-incident","prefLabel":{"en":"Food safety incident"},"definition":{"en":"An occurrence in which a food product is associated with an actual or potential threat to health."},"narrower":[{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/food-contamination","prefLabel":{"en":"Food contamination"},"definition":{"en":"The presence or introduction of a potentially harmful biological, chemical or physical agent in food."}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/one-off-incident","prefLabel":{"en":"Apparently unique food safety incident"},"altLabel":{"en":["One-off incident"]},"definition":{"en":"An incident initially considered unusual, unique or difficult to predict."}}]}]},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/emerging-risk-identification","prefLabel":{"en":"Emerging risk identification"},"definition":{"en":"The systematic identification and evaluation of information that may indicate a new or changing food safety hazard or risk."},"narrower":[{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/early-signal","prefLabel":{"en":"Early signal"},"altLabel":{"en":["Early warning signal","Precursor signal"]},"definition":{"en":"Documented information that precedes public recognition of a food safety incident and may indicate the development of a food safety hazard or risk."},"narrower":[{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/indirect-early-signal","prefLabel":{"en":"Indirect early signal"},"altLabel":{"en":["Possible hazard link"]},"definition":{"en":"The earliest documented indication of a possible indirect relationship between a hazard and the food product involved in a later incident."}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/direct-early-signal","prefLabel":{"en":"Direct early signal"},"altLabel":{"en":["First direct link"]},"definition":{"en":"The first written evidence of a direct relationship between a hazard and a food product before general public announcement."}}]},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/early-signal-detection","prefLabel":{"en":"Early signal detection"},"definition":{"en":"The identification of information that may precede and indicate an emerging food safety hazard or risk."}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/horizon-scanning","prefLabel":{"en":"Horizon scanning"},"definition":{"en":"Systematic examination of information for developments that may become relevant to future food safety."}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/scenario-development","prefLabel":{"en":"Scenario development"},"definition":{"en":"Development of plausible pathways by which an identified hazard may evolve into a food safety risk or incident."}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/information-extraction","prefLabel":{"en":"Information extraction"},"definition":{"en":"Extraction of relevant concepts and relationships from textual data sources."}}]},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/historical-case-analysis","prefLabel":{"en":"Historical case analysis"},"altLabel":{"en":["Retrospective case analysis"]},"definition":{"en":"The retrospective reconstruction and evaluation of events preceding a food safety incident."},"narrower":[{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-timeline","prefLabel":{"en":"Historical case timeline"},"altLabel":{"en":["Incident timeline"]},"definition":{"en":"A chronological representation of early signals, consecutive events and public announcements associated with a food safety case."}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-event","prefLabel":{"en":"Historical case event"},"definition":{"en":"A documented occurrence forming part of the development of a historical food safety case."}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-reconstruction","prefLabel":{"en":"Case reconstruction"},"definition":{"en":"The process of identifying and ordering documents and events that describe the development of a historical food safety incident."}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/retrospective-multi-case-analysis","prefLabel":{"en":"Retrospective multi-case analysis"},"definition":{"en":"An analysis of multiple past incidents intended to identify common characteristics, patterns and lessons."}}]},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/historical-food-safety-case","prefLabel":{"en":"Historical food safety case"},"altLabel":{"en":["Past food safety case"]},"definition":{"en":"A past food safety incident or hazard development studied retrospectively to identify early signals, event sequences and lessons for future risk identification."},"narrower":[{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-3-mcpd-soy-sauce","prefLabel":{"en":"3-MCPD in soy sauce case"}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-acrylamide-fried-food","prefLabel":{"en":"Acrylamide in fried food case"}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-benzene-soft-drinks","prefLabel":{"en":"Benzene in soft drinks case"}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-bpa-canned-food","prefLabel":{"en":"Bisphenol A in canned food case"},"altLabel":{"en":["BPA in canned food case"]}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-bse-cow-meat","prefLabel":{"en":"BSE in cow meat case"}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-cronobacter-infant-formula","prefLabel":{"en":"Cronobacter sakazakii in infant formula case"}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-dioxin-cow-milk","prefLabel":{"en":"Dioxin via clay in cow milk case"}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-furan-food","prefLabel":{"en":"Furan in thermally processed food case"}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-itx-infant-formula","prefLabel":{"en":"ITX in infant formula case"}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-melamine-infant-milk","prefLabel":{"en":"Melamine in infant milk powder case"}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-pfos-pfoa-water","prefLabel":{"en":"PFOS/PFOA in drinking water case"}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-semicarbazide-food","prefLabel":{"en":"Semicarbazide in packaged food case"}},{"id":"https://fredbrug.github.io/skohub-pages/emerging-food-safety/case-sudan-i-chilli","prefLabel":{"en":"Sudan I in chilli products case"}}]}],"@context":{"@version":1.1,"id":"@id","type":"@type","@vocab":"http://www.w3.org/2004/02/skos/core#","xsd":"http://www.w3.org/2001/XMLSchema#","dct":"http://purl.org/dc/terms/","dc":"http://purl.org/dc/elements/1.1/","schema":"https://schema.org/","vann":"http://purl.org/vocab/vann/","ldp":"http://www.w3.org/ns/ldp#","owl":"http://www.w3.org/2002/07/owl#","title":{"@id":"dct:title","@container":"@language"},"dc:title":{"@id":"dc:title","@container":"@language"},"dc:description":{"@id":"dc:description","@container":"@language"},"description":{"@id":"dct:description","@container":"@language"},"license":{"@id":"dct:license","@container":"@language"},"issued":{"@id":"dct:issued","@type":"xsd:date"},"created":{"@id":"dct:created","@type":"xsd:date"},"modified":{"@id":"dct:modified","@type":"xsd:date"},"creator":"dct:creator","publisher":"dct:publisher","preferredNamespacePrefix":"vann:preferredNamespacePrefix","preferredNamespaceUri":"vann:preferredNamespaceUri","isBasedOn":"schema:isBasedOn","source":"dct:source","prefLabel":{"@container":"@language"},"altLabel":{"@container":["@language","@set"]},"hiddenLabel":{"@container":["@language","@set"]},"definition":{"@container":"@language"},"note":{"@container":["@language","@set"]},"changeNote":{"@container":["@language","@set"]},"editorialNote":{"@container":["@language","@set"]},"historyNote":{"@container":["@language","@set"]},"scopeNote":{"@container":["@language","@set"]},"notation":{"@container":"@set"},"example":{"@container":"@language"},"narrower":{"@container":"@set"},"related":{"@container":"@set"},"relatedMatch":{"@container":"@set"},"narrowerTransitive":{"@container":"@set"},"broaderTransitive":{"@container":"@set"},"broadMatch":{"@container":"@set"},"narrowMatch":{"@container":"@set"},"closeMatch":{"@container":"@set"},"exactMatch":{"@container":"@set"},"hasTopConcept":{"@container":"@set"},"inScheme":{"@container":"@set"},"topConceptOf":{"@container":"@set"},"deprecated":{"@id":"owl:deprecated","@type":"xsd:boolean"},"isReplacedBy":{"@id":"dct:isReplacedBy","@container":"@set"}}}