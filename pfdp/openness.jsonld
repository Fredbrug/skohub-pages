{
  "id": "https://fredbrug.github.io/skohub-pages/pfdp/openness",
  "type": "Concept",
  "prefLabel": {
    "en": "Openness",
    "nl": "Openheid"
  },
  "altLabel": {
    "en": [
      "Open practices"
    ],
    "nl": [
      "Open werkwijzen"
    ]
  },
  "definition": {
    "en": "The degree to which data, methods, decisions, and outputs are accessible, understandable, and reusable with minimal unnecessary restriction.",
    "nl": "De mate waarin data, methoden, besluiten en resultaten toegankelijk, begrijpelijk en herbruikbaar zijn met zo min mogelijk onnodige beperkingen."
  },
  "scopeNote": {
    "en": [
      "Use for policies, requirements or practices specifically concerning openness. Use the broader concept for statements that do not distinguish this specific aspect."
    ]
  },
  "notation": [
    "OPE"
  ],
  "broader": {
    "id": "https://fredbrug.github.io/skohub-pages/pfdp/transparency-and-openness",
    "prefLabel": {
      "en": "Transparency and openness",
      "nl": "Transparantie en openheid"
    }
  },
