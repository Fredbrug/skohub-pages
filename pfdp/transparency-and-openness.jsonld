{
  "id": "https://fredbrug.github.io/skohub-pages/pfdp/transparency-and-openness",
  "type": "Concept",
  "prefLabel": {
    "en": "Transparency and openness",
    "nl": "Transparantie en openheid"
  },
  "altLabel": {
    "en": [
      "Openness and transparency"
    ],
    "nl": [
      "Openheid en transparantie"
    ]
  },
  "definition": {
    "en": "The principle that data-related decisions, methods, conditions, and outputs should be understandable and as openly accessible as possible while respecting legitimate restrictions.",
    "nl": "Het beginsel dat datagerelateerde besluiten, methoden, voorwaarden en resultaten begrijpelijk en zo open mogelijk toegankelijk moeten zijn, met inachtneming van gerechtvaardigde beperkingen."
  },
  "scopeNote": {
    "en": [
      "Use for general statements about transparency and openness and for grouping the more specific concepts listed beneath it. Prefer a narrower concept when the statement is more specific."
    ]
  },
  "notation": [
    "TO"
  ],
