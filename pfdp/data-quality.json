{
  "id": "https://fredbrug.github.io/skohub-pages/pfdp/data-quality",
  "type": "Concept",
  "prefLabel": {
    "en": "Data quality",
    "nl": "Datakwaliteit"
  },
  "altLabel": {
    "en": [
      "Quality of data"
    ],
    "nl": [
      "Kwaliteit van data"
    ]
  },
  "definition": {
    "en": "The degree to which data meet defined requirements and are fit for their intended uses, commonly assessed through dimensions such as accuracy, completeness, consistency, timeliness, validity, and uniqueness.",
    "nl": "De mate waarin data voldoen aan vastgestelde eisen en geschikt zijn voor het beoogde gebruik, vaak beoordeeld aan de hand van dimensies zoals nauwkeurigheid, volledigheid, consistentie, tijdigheid, validiteit en uniciteit."
  },
  "scopeNote": {
    "en": [
      "Use for policies, requirements or practices specifically concerning data quality. Use the broader concept for statements that do not distinguish this specific aspect."
    ]
  },
  "notation": [
    "DQ"
  ],
  "broader": {
    "id": "https://fredbrug.github.io/skohub-pages/pfdp/data-management-general",
