{
  "id": "https://fredbrug.github.io/skohub-pages/pfdp/fair",
  "type": "Concept",
  "prefLabel": {
    "en": "FAIR",
    "nl": "FAIR"
  },
  "altLabel": {
    "en": [
      "FAIR data principles",
      "FAIR principles"
    ],
    "nl": [
      "FAIR-dataprincipes",
      "FAIR-principes"
    ]
  },
  "definition": {
    "en": "A set of guiding principles intended to make data and metadata Findable, Accessible, Interoperable, and Reusable by people and machines.",
    "nl": "Een geheel van leidende principes dat beoogt data en metadata vindbaar, toegankelijk, interoperabel en herbruikbaar te maken voor mensen en machines."
  },
  "scopeNote": {
    "en": [
      "Use for general statements about fair and for grouping the more specific concepts listed beneath it. Prefer a narrower concept when the statement is more specific."
    ]
  },
  "notation": [
    "FAIR"
  ],
  "narrower": [
    {
      "id": "https://fredbrug.github.io/skohub-pages/pfdp/findable",
