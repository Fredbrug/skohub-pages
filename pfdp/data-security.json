{
  "id": "https://fredbrug.github.io/skohub-pages/pfdp/data-security",
  "type": "Concept",
  "prefLabel": {
    "en": "Data security",
    "nl": "Databeveiliging"
  },
  "altLabel": {
    "en": [
      "Information security for data",
      "Data protection controls"
    ],
    "nl": [
      "Informatiebeveiliging van data",
      "Beveiligingsmaatregelen voor data"
    ]
  },
  "definition": {
    "en": "The planning and application of controls that protect data against unauthorized access, use, disclosure, alteration, loss, or destruction while supporting appropriate availability.",
    "nl": "Het plannen en toepassen van maatregelen die data beschermen tegen ongeoorloofde toegang, gebruik, openbaarmaking, wijziging, verlies of vernietiging en tegelijkertijd passende beschikbaarheid ondersteunen."
  },
  "scopeNote": {
    "en": [
      "Use for general statements about data security and for grouping the more specific concepts listed beneath it. Prefer a narrower concept when the statement is more specific."
    ]
  },
  "notation": [
    "DS"
  ],
