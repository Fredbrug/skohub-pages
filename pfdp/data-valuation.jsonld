{
  "id": "https://fredbrug.github.io/skohub-pages/pfdp/data-valuation",
  "type": "Concept",
  "prefLabel": {
    "en": "Data valuation",
    "nl": "Datawaardering"
  },
  "altLabel": {
    "en": [
      "Valuation of data",
      "Data value assessment"
    ],
    "nl": [
      "Waardering van data",
      "Beoordeling van datawaarde"
    ]
  },
  "definition": {
    "en": "The systematic assessment of the financial, operational, scientific, legal, or societal value of data and of the costs and risks associated with managing it.",
    "nl": "De systematische beoordeling van de financiële, operationele, wetenschappelijke, juridische of maatschappelijke waarde van data en van de kosten en risico’s van het beheer ervan."
  },
  "scopeNote": {
    "en": [
      "Data valuation is the assessment of the economic value of data. \n(https://echa.europa.eu/documents/10162/2324906/guidance_on\n_data_sharing_en.pdf/545e4463-9e67-43f0-852f\n35e70a8ead60?t=1669385322122 )"
    ]
  },
  "notation": [
    "DV"
  ],
  "broader": {
    "id": "https://fredbrug.github.io/skohub-pages/pfdp/data-governance-general",
    "prefLabel": {
      "en": "Data governance (general)",
      "nl": "Datagovernance (algemeen)"
    }
  },
  "inScheme": [
    {
      "id": "https://fredbrug.github.io/skohub-pages/pfdp",
      "title": {
        "en": "PARC FAIR Data Policy",
        "nl": "PARC FAIR Data Policy"
      }
    }
  ],
