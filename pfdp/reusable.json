  "type": "Concept",
  "prefLabel": {
    "en": "Reusable",
    "nl": "Herbruikbaar"
  },
  "altLabel": {
    "en": [
      "Reusability"
    ],
    "nl": [
      "Herbruikbaarheid"
    ]
  },
  "definition": {
    "en": "The condition in which data and metadata are sufficiently described, licensed, provenance-rich, and compliant with relevant standards to support use beyond their original purpose.",
    "nl": "De toestand waarin data en metadata voldoende zijn beschreven, gelicentieerd, van herkomstinformatie voorzien en in overeenstemming met relevante standaarden zijn om gebruik buiten het oorspronkelijke doel mogelijk te maken."
  },
  "scopeNote": {
    "en": [
      "Use for general statements about reusable and for grouping the more specific concepts listed beneath it. Prefer a narrower concept when the statement is more specific."
    ]
  },
