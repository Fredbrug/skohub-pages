{
  "id": "https://fredbrug.github.io/skohub-pages/pfdp/interoperable",
  "type": "Concept",
  "prefLabel": {
    "en": "Interoperable",
    "nl": "Interoperabel"
  },
  "altLabel": {
    "en": [
      "Interoperability-ready"
    ],
    "nl": [
      "Uitwisselbaar"
    ]
  },
  "definition": {
    "en": "The condition in which data and metadata use shared languages, formats, vocabularies, identifiers, and qualified relationships so they can be integrated and used across systems and domains.",
    "nl": "De toestand waarin data en metadata gedeelde talen, formaten, vocabulaires, identificatoren en gekwalificeerde relaties gebruiken, zodat zij over systemen en domeinen heen kunnen worden geïntegreerd en gebruikt."
  },
  "scopeNote": {
    "en": [
      "Use for general statements about interoperable and for grouping the more specific concepts listed beneath it. Prefer a narrower concept when the statement is more specific."
    ]
  },
  "notation": [
    "INT"
  ],
  "narrower": [
