{
  "id": "https://fredbrug.github.io/skohub-pages/pfdp/sensitive-data",
  "type": "Concept",
  "prefLabel": {
    "en": "Sensitive data",
    "nl": "Gevoelige data"
  },
  "altLabel": {
    "en": [
      "Restricted data",
      "Confidential data"
    ],
    "nl": [
      "Beschermde data",
      "Vertrouwelijke data"
    ]
  },
  "definition": {
    "en": "Data that require additional protection because unauthorized access, disclosure, alteration, or misuse could harm individuals, organizations, communities, security, or legitimate interests.",
    "nl": "Data die aanvullende bescherming vereisen omdat ongeoorloofde toegang, openbaarmaking, wijziging of misbruik schade kan berokkenen aan personen, organisaties, gemeenschappen, veiligheid of gerechtvaardigde belangen."
  },
  "scopeNote": {
    "en": [
      "Use for general statements about sensitive data and for grouping the more specific concepts listed beneath it. Prefer a narrower concept when the statement is more specific."
    ]
  },
