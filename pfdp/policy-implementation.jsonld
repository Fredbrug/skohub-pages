{
  "id": "https://fredbrug.github.io/skohub-pages/pfdp/policy-implementation",
  "type": "Concept",
  "prefLabel": {
    "en": "Policy implementation",
    "nl": "Beleidsimplementatie"
  },
  "altLabel": {
    "en": [
      "Implementation of policy",
      "Policy operationalisation"
    ],
    "nl": [
      "Implementatie van beleid",
      "Operationalisering van beleid"
    ]
  },
  "definition": {
    "en": "The coordinated actions, controls, resources, communication, training, and monitoring used to put a data policy into operational practice.",
    "nl": "De gecoördineerde maatregelen, beheersingsmechanismen, middelen, communicatie, opleiding en monitoring waarmee een databeleid in de operationele praktijk wordt gebracht."
  },
  "scopeNote": {
    "en": [
      "Use for policies, requirements or practices specifically concerning policy implementation. Use the broader concept for statements that do not distinguish this specific aspect."
    ]
  },
  "notation": [
    "PI"
  ],
  "broader": {
    "id": "https://fredbrug.github.io/skohub-pages/pfdp/data-policy",
