{
  "id": "https://fredbrug.github.io/skohub-pages/pfdp/applicable-laws-and-regulations-laws-contracts-funder-requirements-policies-guidelines-com",
  "type": "Concept",
  "prefLabel": {
    "en": "Applicable laws and regulations (laws, contracts, funder requirements, policies, guidelines, combined/aligned with the EU Common Open Data Platform, ECHA, Horizon Europe, OECD, Science Europe)",
    "nl": "Toepasselijke wet- en regelgeving (wetten, contracten, eisen van financiers, beleid en richtlijnen, gecombineerd met of afgestemd op het gemeenschappelijke opendataplatform van de EU, ECHA, Horizon Europe, OESO en Science Europe)"
  },
  "altLabel": {
    "en": [
      "Applicable requirements",
      "External requirements",
      "Compliance requirements"
    ],
    "nl": [
      "Toepasselijke vereisten",
      "Externe vereisten",
      "Nalevingsvereisten"
    ]
  },
  "definition": {
    "en": "The specific external and internal requirements with which a data policy is aligned, including legislation, contracts, funder conditions, policies, guidelines, and relevant European or international frameworks.",
    "nl": "De specifieke externe en interne vereisten waarop een databeleid is afgestemd, waaronder wetgeving, contracten, voorwaarden van financiers, beleid, richtlijnen en relevante Europese of internationale kaders."
  },
  "scopeNote": {
    "en": [
      "Use for policies, requirements or practices specifically concerning applicable laws and regulations (laws, contracts, funder requirements, policies, guidelines, combined/aligned with the eu common open data platform, echa, horizon europe, oecd, science europe). Use the broader concept for statements that do not distinguish this specific aspect."
    ]
  },
  "notation": [
    "ALR2"
  ],
  "broader": {
    "id": "https://fredbrug.github.io/skohub-pages/pfdp/applicable-laws-and-regulations-general",
