{
  "id": "https://fredbrug.github.io/skohub-pages/pfdp/data-governance-process-board-committee-etc",
  "type": "Concept",
  "prefLabel": {
    "en": "Data governance (process, Board, committee etc.)",
    "nl": "Datagovernance (proces, bestuur, commissie enz.)"
  },
  "altLabel": {
    "en": [
      "Data governance structure",
      "Data governance process",
      "Data governance board"
    ],
    "nl": [
      "Datagovernancestructuur",
      "Datagovernanceproces",
      "Datagovernancebestuur"
    ]
  },
  "definition": {
    "en": "The formal structures and processes, such as boards, committees, decision forums, and escalation routes, used to direct and oversee data-related decisions.",
    "nl": "De formele structuren en processen, zoals besturen, commissies, besluitvormingsfora en escalatieroutes, waarmee datagerelateerde besluiten worden aangestuurd en gecontroleerd."
  },
  "scopeNote": {
    "en": [
      "Use for policies, requirements or practices specifically concerning data governance (process, board, committee etc.). Use the broader concept for statements that do not distinguish this specific aspect."
    ]
  },
  "notation": [
    "DG2"
  ],
  "broader": {
