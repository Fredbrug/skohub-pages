    "nl": [
      "Data-archivering",
      "Digitale archivering"
    ]
  },
  "definition": {
    "en": "The managed transfer and storage of data and associated documentation for retention, preservation, discovery, access, and possible reuse over a defined period.",
    "nl": "De beheerste overdracht en opslag van data en bijbehorende documentatie ten behoeve van bewaring, preservering, vindbaarheid, toegang en mogelijk hergebruik gedurende een vastgestelde periode."
  },
  "scopeNote": {
    "en": [
      "Use for general statements about archiving and for grouping the more specific concepts listed beneath it. Prefer a narrower concept when the statement is more specific."
    ]
  },
